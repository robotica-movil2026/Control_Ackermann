<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <xacro:include filename="common_propperties.xacro"/>
  <xacro:include filename="mobile_baseg.xacro"/>
  <xacro:include filename="mobile_baseg.ros2_control.xacro"/>
  <xacro:include filename="mobile_base.gazebo.xacro"/>




  <!-- instancia el robot -->
  <xacro:carlikebot prefix=""/>

  <!-- instancia el bloque ros2_control -->
  <xacro:carlikebot_ros2_control
    prefix=""
    hardware_type="gazebo"/>

  <xacro:carlikebot_gazebo prefix=""/>


</robot>