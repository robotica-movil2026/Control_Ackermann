<launch>

  <!-- robot_description: se procesa el xacro pidiendo explícitamente
       sim_mode:=true (para que <ros2_control> use gz_ros2_control/GazeboSimSystem)
       y pasando la ruta al mismo controllers.yaml que usa tu launch de hardware real -->
  <let name="robot_description"
       value="$(command 'xacro $(find-pkg-share mi_ackermann_description)/urdf/my_robotg.urdf.xacro
              sim_mode:=true
              controllers_config:=$(find-pkg-share mi_ackermann_bringup)/config/carlikebotgazebo_controllers.yaml')"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(var robot_description)" type="str"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- Levanta Gazebo Harmonic con tu mundo -->
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-r $(find-pkg-share mi_ackermann_bringup)/world/my_world.sdf"/>
  </include>

  <!-- Puente ROS<->Gazebo: solo /clock, ya que odometría/joint_states/tf
       son nativos de ROS 2 gracias a ros2_control (ver bridge_config.yaml) -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
    <param name="config_file"
           value="$(find-pkg-share mi_ackermann_bringup)/config/bridge_config.yaml"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- Spawnea el robot en Gazebo leyendo /robot_description.
       Al aparecer, el plugin gz_ros2_control (dentro de tu .gazebo.xacro)
       crea automáticamente el controller_manager -->
  <node pkg="ros_gz_sim" exec="create" output="screen"
        args="-topic /robot_description -name carlikebot -z 0.1"/>

  <!-- Igual que en tu launch de hardware real: el spawner espera/reintenta
       hasta que el controller_manager exista, así que no necesita delay explícito -->
  <node pkg="controller_manager" exec="spawner"
        args="joint_state_broadcaster
              bicycle_steering_controller
              --controller-ros-args
              '--ros-args -r /bicycle_steering_controller/tf_odometry:=/tf'"/>

  <!-- manda velocidad cero inmediatamente para inicializar la odometría -->
  <timer period="3.0">
    <executable cmd="ros2 topic pub --times 10 --rate 10
      /bicycle_steering_controller/reference
      geometry_msgs/msg/TwistStamped
      '{header: {stamp: {sec: 1}, frame_id: base_link}, twist: {linear: {x: 0.001}, angular: {z: 0.0}}}'"/>
  </timer>

</launch>